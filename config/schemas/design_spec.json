{
  "type": "object",
  "required": ["files", "engine_api", "tabs", "performance", "criteria_map"],
  "properties": {
    "files": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["path", "role", "responsibility"], "properties": {
      "path": {"type": "string", "minLength": 3},
      "role": {"type": "string", "enum": ["entry", "engine", "tab", "test", "config", "data"]},
      "responsibility": {"type": "string", "minLength": 5}}}},
    "engine_api": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["function", "inputs", "outputs"], "properties": {"function": {"type": "string"}, "inputs": {"type": "string"}, "outputs": {"type": "string"}}}},
    "tabs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "controls", "plots"], "properties": {
      "id": {"type": "string", "minLength": 2},
      "title": {"type": "string"},
      "controls": {"type": "array", "items": {"type": "object", "required": ["id", "type"], "properties": {
        "id": {"type": "string"},
        "type": {"type": "string", "enum": ["slider", "select", "text", "button", "file_input", "toggle", "table"]},
        "hyperparameter": {"type": "string"}, "default": {"type": ["string", "number", "boolean"]}}}},
      "plots": {"type": "array", "items": {"type": "object", "required": ["id", "question_answered", "kind", "data_source"], "properties": {
        "id": {"type": "string"}, "question_answered": {"type": "string", "minLength": 8}, "kind": {"type": "string"}, "data_source": {"type": "string"}}}}}}},
    "performance": {"type": "object", "required": ["strategy", "background_training", "notes"], "properties": {"strategy": {"type": "string", "minLength": 5}, "background_training": {"type": "boolean"}, "notes": {"type": "string"}}},
    "criteria_map": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion_id", "implemented_by"], "properties": {"criterion_id": {"type": "string"}, "implemented_by": {"type": "string"}}}}
  }
}
