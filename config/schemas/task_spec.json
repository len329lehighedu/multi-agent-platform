{
  "type": "object",
  "required": ["title", "learner_audience", "learning_objectives", "tags", "data", "capabilities", "constraints", "acceptance_criteria", "assumptions", "budget"],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "learner_audience": {"type": "string", "minLength": 3},
    "learning_objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["equation_discovery", "time_series", "classification", "regression", "neural_network", "optimization", "tabular"]}},
    "data": {"type": "object", "required": ["source", "description"], "properties": {
      "source": {"type": "string", "enum": ["builtin_simulated", "user_upload", "both"]},
      "description": {"type": "string", "minLength": 3}}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["train", "test", "predict", "analyze"]}},
    "constraints": {"type": "object", "required": ["max_train_seconds"], "properties": {
      "max_train_seconds": {"type": "number"}, "notes": {"type": "string"}}},
    "acceptance_criteria": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "statement", "verification"], "properties": {
      "id": {"type": "string", "minLength": 2},
      "statement": {"type": "string", "minLength": 10},
      "verification": {"type": "string", "enum": ["unit_test", "ui_contract_test", "browser_check", "scientific_oracle", "manual"]}}}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "budget": {"type": "object", "required": ["max_repair_cycles"], "properties": {"max_repair_cycles": {"type": "integer"}}}
  }
}
